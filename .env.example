# Copy to .env for local testing with `netlify dev`. Never commit .env.
# In production these are set in Netlify → Site configuration → Environment variables.
RESEND_API_KEY=
ORDER_FROM="Wilson Dance Factory <order@wilsondancefactory.se>"
# One or several addresses, comma-separated
ORDER_TO=info@wilsondancefactory.se
# Password for the order list at /admin/bestallningar/
ORDERS_PASSWORD=
# 1 = log the order mails instead of sending them
ORDER_DRY_RUN=1
