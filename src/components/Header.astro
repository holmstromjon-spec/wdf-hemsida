---
// Dark header as on the old site: diamond logo left, contact row + shop button on top,
// the menu below with "Dansa med oss" as a dropdown. Phones get a full menu panel.
import { Image } from 'astro:assets';
import logo from '../assets/images/brand/logo.png';
import { nav } from '../lib/nav';
import { site } from '../lib/data';
import Icon from './Icon.astro';

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href;
const isSection = (item: (typeof nav)[number]) =>
  isCurrent(item.href) || item.children?.some((c) => isCurrent(c.href));
const mainNav = nav.filter((n) => n.href !== '/shop/');
---

<header class="site-header on-dark">
  <div class="container bar">
    <a class="brand" href="/" aria-label="Wilson Dance Factory – till startsidan">
      <Image src={logo} alt="" width={120} height={109} loading="eager" />
    </a>

    <div class="right">
      <div class="top">
        <a href={`mailto:${site.epost}`}><Icon name="mail" />{site.epost}</a>
        <a href={site.telefon_href}><Icon name="phone" />{site.telefon}</a>
        <a href={site.sociala.facebook} rel="noopener" aria-label="Facebook"><Icon name="facebook" /></a>
        <a href={site.sociala.instagram} rel="noopener" aria-label="Instagram"><Icon name="instagram" /></a>
        <a class="button shop" href="/shop/">Butik <span class="arrow" aria-hidden="true"></span></a>
      </div>

      <nav class="main" aria-label="Huvudmeny">
        <ul role="list">
          {mainNav.map((item) =>
            item.children ? (
              <li class="has-sub">
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined} class:list={{ active: isSection(item) }}>
                  {item.label} <span class="caret" aria-hidden="true">▾</span>
                </a>
                <ul role="list" class="sub">
                  {item.children.map((c) => (
                    <li><a href={c.href} aria-current={isCurrent(c.href) ? 'page' : undefined}>{c.label}</a></li>
                  ))}
                </ul>
              </li>
            ) : (
              <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
            ),
          )}
        </ul>
      </nav>
    </div>

    <button class="menu-toggle" type="button" popovertarget="meny" aria-label="Öppna menyn">
      <span class="burger" aria-hidden="true"></span>
    </button>
  </div>

  <div id="meny" class="menu on-dark" popover>
    <div class="menu-top">
      <span class="menu-title">Meny</span>
      <button class="menu-close" type="button" popovertarget="meny" popovertargetaction="hide">Stäng ✕</button>
    </div>
    <nav aria-label="Mobilmeny">
      <ul role="list" class="menu-list">
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
            {item.children && (
              <ul role="list" class="menu-sub">
                {item.children.map((c) => (
                  <li><a href={c.href} aria-current={isCurrent(c.href) ? 'page' : undefined}>{c.label}</a></li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
    <div class="menu-contact">
      <a href={`mailto:${site.epost}`}><Icon name="mail" />{site.epost}</a>
      <a href={site.telefon_href}><Icon name="phone" />{site.telefon}</a>
      <span class="menu-social">
        <a href={site.sociala.facebook} rel="noopener" aria-label="Facebook"><Icon name="facebook" /></a>
        <a href={site.sociala.instagram} rel="noopener" aria-label="Instagram"><Icon name="instagram" /></a>
      </span>
    </div>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 30; background: rgb(32 31 31 / 0.96); backdrop-filter: blur(6px); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; min-height: 4.5rem; }
  .brand { display: block; align-self: flex-start; margin-top: 0.5rem; }
  .brand img { width: 64px; height: auto; margin-bottom: -1.5rem; position: relative; z-index: 2; filter: drop-shadow(0 4px 10px rgb(0 0 0 / 0.35)); }

  .right { display: none; flex-direction: column; align-items: flex-end; gap: 0.4rem; padding-block: 0.6rem; }
  .top { display: flex; align-items: center; gap: 1.25rem; font-size: var(--fs-small); }
  .top a:not(.button) { display: inline-flex; align-items: center; gap: 0.45rem; text-decoration: none; opacity: 0.9; }
  .top a:not(.button):hover { opacity: 1; text-decoration: underline; }
  .shop { min-height: 2.1rem; padding: 0.3rem 0.85rem; font-size: 0.875rem; }

  .main > ul { display: flex; gap: 1.75rem; }
  .main a { display: inline-block; padding: 0.35rem 0; text-decoration: none; font-weight: 500; font-size: 0.9375rem; }
  .main a:hover, .main a[aria-current='page'], .main a.active { color: #ff8a80; }
  .caret { font-size: 0.7em; margin-left: 0.15em; }
  .has-sub { position: relative; }
  .sub {
    position: absolute; left: -1rem; top: 100%; min-width: 14rem; padding: 0.5rem 0;
    background: var(--dark); border-top: 2px solid var(--red); border-radius: 0 0 var(--radius) var(--radius);
    box-shadow: 0 12px 30px rgb(0 0 0 / 0.3);
    opacity: 0; visibility: hidden; translate: 0 6px; transition: opacity 150ms, translate 150ms, visibility 150ms;
  }
  .has-sub:hover .sub, .has-sub:focus-within .sub { opacity: 1; visibility: visible; translate: 0 0; }
  .sub a { display: block; padding: 0.5rem 1rem; font-weight: 400; }
  .sub a:hover { background: var(--dark-2); color: var(--white); }

  .menu-toggle { display: grid; place-items: center; width: 3rem; height: 3rem; border: 0; background: transparent; cursor: pointer; }
  .burger, .burger::before, .burger::after { display: block; width: 26px; height: 2px; background: var(--white); content: ''; position: relative; }
  .burger::before { position: absolute; top: -8px; }
  .burger::after { position: absolute; top: 8px; }

  @media (min-width: 64rem) {
    .right { display: flex; }
    .menu-toggle { display: none; }
    .brand img { width: 84px; margin-bottom: -2.25rem; }
  }

  .menu {
    position: fixed; inset: 0; width: 100%; height: 100%; max-width: none; max-height: none;
    margin: 0; border: 0; padding: 1rem var(--pad) 2rem; overflow-y: auto;
  }
  .menu:popover-open { display: flex; flex-direction: column; gap: 1.5rem; }
  .menu-top { display: flex; justify-content: space-between; align-items: center; min-height: 3rem; }
  .menu-title { font-size: var(--fs-h4); font-weight: 300; }
  .menu-close { border: 0; background: transparent; color: var(--white); font-weight: 500; cursor: pointer; padding: 0.75rem 0; }
  .menu-list > li { border-bottom: 1px solid rgb(255 255 255 / 0.12); }
  .menu-list > li > a { display: block; padding: 0.85rem 0; font-size: 1.25rem; font-weight: 300; text-decoration: none; }
  .menu-list a[aria-current='page'] { color: #ff8a80; }
  .menu-sub { padding: 0 0 0.75rem 1rem; display: grid; gap: 0.35rem; }
  .menu-sub a { text-decoration: none; opacity: 0.85; }
  .menu-contact { display: grid; gap: 0.75rem; margin-top: auto; font-size: var(--fs-small); }
  .menu-contact a { display: inline-flex; align-items: center; gap: 0.5rem; text-decoration: none; }
  .menu-social { display: flex; gap: 1rem; }
</style>
