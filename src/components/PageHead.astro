---
// Poster headline for a page: heavy type filling the width on a flat ground,
// with an optional photograph cut in from the right, tilted.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** The h1, one entry per line (lines are authored, never left to wrap). */
  lines: string[];
  lead?: string;
  ground?: 'red' | 'black' | 'paper';
  image?: ImageMetadata;
  imageAlt?: string;
  action?: { label: string; href: string };
}

const { lines, lead, ground = 'red', image, imageAlt = '', action } = Astro.props;
// The longest line decides the size, so every line fits the width without wrapping.
const chars = Math.max(...lines.map((l) => l.length));
---

<section class:list={['page-head', `on-${ground}`, { 'has-image': image }]}>
  <div class="page-head-inner wrap">
    <h1 class="display page-title" style={`--chars:${chars}`}>
      {lines.map((line) => <span class="mask-line"><span>{line}</span></span>)}
    </h1>
    {(lead || action || Astro.slots.has('default')) && (
      <div class="page-head-text after-mask">
        {lead && <p class="lead">{lead}</p>}
        {action && <a class="button" href={action.href}><span>{action.label}</span> <span class="arrow" aria-hidden="true"></span></a>}
        <slot />
      </div>
    )}
  </div>
  {image && (
    <div class="page-head-photo tilt-r after-mask">
      <Image src={image} alt={imageAlt} widths={[480, 800, 1200]} sizes="(min-width: 60rem) 34vw, 80vw" loading="eager" class="photo" />
    </div>
  )}
</section>

<style>
  .page-head {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3rem, 2rem + 5vw, 7rem) clamp(3.5rem, 2rem + 6vw, 8rem);
  }
  .page-title {
    /* Panchang runs ~1em per capital (Å/Ä/Ö a little more): fit the longest line to the width. */
    font-size: min(var(--step-poster), calc((100vw - 2 * var(--margin)) / (var(--chars) * 1.06)));
    line-height: 0.88;
    max-width: 100%;
  }
  .page-head-text {
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
    max-width: 38rem;
    display: grid;
    gap: 1.75rem;
    justify-items: start;
  }
  .page-head-photo {
    width: min(80vw, 26rem);
    aspect-ratio: 4 / 5;
    margin: 3rem var(--margin) 0 auto;
    overflow: hidden;
  }
  @media (min-width: 60rem) {
    .has-image .page-head-inner { padding-right: 36vw; }
    .has-image .page-title { font-size: min(var(--step-poster), calc((64vw - 2 * var(--margin)) / (var(--chars) * 1.06))); }
    .page-head-photo {
      position: absolute;
      right: var(--margin);
      top: 50%;
      width: 30vw;
      margin: 0;
      translate: 0 -46%;
    }
  }
</style>
