---
// Page banner as on the old site: a darkened photograph with the page title in light type.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import fallback from '../assets/images/headers/header-2.jpg';

interface Props {
  title: string;
  lead?: string;
  image?: ImageMetadata;
  action?: { label: string; href: string };
}

const { title, lead, image = fallback, action } = Astro.props;
---

<section class="page-head photo-bg on-dark">
  <Image src={image} alt="" widths={[800, 1400, 2000]} sizes="100vw" loading="eager" class="bg photo" />
  <div class="container inner">
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    {action && (
      <p><a class="button" href={action.href}>{action.label} <span class="arrow" aria-hidden="true"></span></a></p>
    )}
    <slot />
  </div>
</section>

<style>
  .page-head { min-height: clamp(14rem, 10rem + 12vw, 22rem); display: grid; align-items: end; }
  .inner { padding-block: 4rem 2.75rem; display: grid; gap: 1rem; justify-items: start; }
  .inner .lead { max-width: 46rem; }
</style>
