---
// "Vi vill veta vad du tycker om oss!" + Google reviews via Trustindex.
// Trustindex is only loaded on the pages that include this component.
import { site } from '../lib/data';
---

<section class="reviews on-light section" aria-labelledby="reviews-title">
  <div class="container center stack">
    <h2 id="reviews-title">Vi vill veta vad du tycker om oss!</h2>
    <p class="intro">På Wilson Dance Factory är vi väldigt lyhörda och uppskattar alltid möjligheten att kunna förbättra vår verksamhet. Det gör vi bäst genom att lyssna noga på vad våra medlemmar och besökare tycker om oss.</p>
    <p class="button-row"><a class="button" href={site.google.recension} rel="noopener">Lämna en Google Review om Wilson Dance Factory här <span class="arrow" aria-hidden="true"></span></a></p>

    <h3 class="sub">Se vad andra tycker om oss</h3>
    {site.trustindex_widget ? (
      <script defer async src={`https://cdn.trustindex.io/loader.js?${site.trustindex_widget}`}></script>
    ) : (
      <p><a class="text-link" href={site.google.recension} rel="noopener">Läs våra recensioner på Google <span class="arrow" aria-hidden="true"></span></a></p>
    )}
  </div>
</section>

<style>
  .intro { max-width: 46rem; margin-inline: auto; }
  .sub { margin-top: 3rem; }
</style>
