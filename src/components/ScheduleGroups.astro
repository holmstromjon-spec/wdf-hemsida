---
// Renders one part of src/data/schema.yaml (weekly or competition schedule).
interface Props {
  grupper: { namn: string; dagar: { dag: string; pass: { tid: string; klass: string }[] }[] }[];
}
const { grupper } = Astro.props;
---

<div class="groups">
  {grupper.map((g) => (
    <section class="group" aria-label={g.namn}>
      <h3 class="group-name">{g.namn}</h3>
      <div class="days">
        {g.dagar.map((d) => (
          <div class="day card">
            <h4 class="day-name">{d.dag}</h4>
            <table>
              <caption class="visually-hidden">{g.namn} – {d.dag}</caption>
              <tbody>
                {d.pass.map((p) => (
                  <tr>
                    <td class="tid tabular">{p.tid}</td>
                    <td>{p.klass}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ))}
      </div>
    </section>
  ))}
</div>

<style>
  .groups { display: grid; gap: 3rem; }
  .group-name { font-size: var(--fs-h3); margin-bottom: 1rem; overflow-wrap: anywhere; }
  .days { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr)); }
  .day { overflow: hidden; }
  .day-name { font-size: 0.9375rem; font-weight: 600; padding: 0.55rem 0.9rem; background: var(--dark); color: var(--white); }
  table { width: 100%; border-collapse: collapse; font-size: 0.9375rem; }
  td { padding: 0.5rem 0.9rem; vertical-align: top; border-top: 1px solid var(--line); }
  tr:first-child td { border-top: 0; }
  .tid { white-space: nowrap; width: 1%; font-weight: 500; }
</style>
