---
// White footer as on the old site: the diamond centred on its top edge, four columns,
// and a red bar along the bottom.
import { Image } from 'astro:assets';
import logo from '../assets/images/brand/logo.png';
import { site } from '../lib/data';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer on-white">
  <div class="mark"><Image src={logo} alt="Wilson Dance Factory" width={140} height={127} /></div>

  <div class="container cols">
    <div>
      <h2 class="h4">Wilson Dance Factory</h2>
      <blockquote class="quote">
        <p>”{site.citat.text}”</p>
        <footer>– {site.citat.namn}<br />{site.citat.titel}</footer>
      </blockquote>
    </div>

    <div>
      <h2 class="h4">Kontakta oss</h2>
      <ul role="list" class="contact">
        <li><Icon name="mail" /><a href={`mailto:${site.epost}`}>{site.epost}</a></li>
        <li><Icon name="phone" /><a href={site.telefon_href}>{site.telefon}</a></li>
        <li><Icon name="pin" /><a href={site.google.vagbeskrivning} rel="noopener">{site.adress.gata}<br />{site.adress.postnummer} {site.adress.ort}</a></li>
      </ul>
      <p class="social">
        <a href={site.sociala.facebook} rel="noopener" aria-label="Facebook"><Icon name="facebook" size={22} /></a>
        <a href={site.sociala.instagram} rel="noopener" aria-label="Instagram"><Icon name="instagram" size={22} /></a>
      </p>
    </div>

    <div>
      <h2 class="h4">Våra öppettider</h2>
      <dl class="hours">
        {site.oppettider.map((o) => (
          <div><dt>{o.dag}</dt><dd class="tabular">{o.tid}</dd></div>
        ))}
      </dl>
    </div>

    <div class="shop">
      <a class="button" href="/shop/">Vår butik <span class="arrow" aria-hidden="true"></span></a>
    </div>
  </div>

  <div class="legal on-red">
    <div class="container legal-row small">
      <span>© {year} {site.namn} · Org.nr {site.orgnr}</span>
      <span><a href="/kopvillkor/">Köpvillkor</a> · <a href="/integritetspolicy/">Integritetspolicy</a></span>
    </div>
  </div>
</footer>

<style>
  .site-footer { position: relative; padding-top: 5rem; border-top: 1px solid var(--line); }
  .mark { position: absolute; left: 50%; top: 0; translate: -50% -45%; width: 90px; }
  .mark img { width: 100%; height: auto; filter: drop-shadow(0 4px 10px rgb(0 0 0 / 0.2)); }
  .cols { display: grid; gap: 2.5rem; padding-bottom: 3rem; }
  .cols .h4 { margin-bottom: 0.9rem; }
  .quote { font-style: italic; color: var(--muted); font-size: 0.9375rem; max-width: 32ch; }
  .quote footer { margin-top: 0.75rem; font-style: normal; }
  .contact { display: grid; gap: 0.6rem; font-size: 0.9375rem; }
  .contact li { display: flex; gap: 0.6rem; align-items: flex-start; }
  .contact .icon { margin-top: 0.2rem; color: var(--muted); }
  .contact a { text-decoration: none; }
  .contact a:hover { color: var(--red); }
  .social { display: flex; gap: 0.9rem; margin-top: 1rem; }
  .social a:hover { color: var(--red); }
  .hours { font-size: 0.9375rem; }
  .hours div { display: flex; justify-content: space-between; gap: 1rem; max-width: 16rem; }
  .hours dt { color: var(--muted); }
  .legal { padding-block: 0.9rem; }
  .legal-row { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 1.5rem; }
  .legal a { color: inherit; }
  @media (min-width: 48rem) { .cols { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 64rem) {
    .cols { grid-template-columns: 1.3fr 1fr 1fr auto; }
    .mark { width: 110px; }
  }
</style>
