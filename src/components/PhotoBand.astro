---
// A band of photographs between two sections: prints laid on a flat ground, alternately tilted.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  photos: ImageMetadata[];
  alt?: string;
  ground?: 'red' | 'black' | 'paper' | 'white';
}
const { photos, alt = 'Dansare från Wilson Dance Factory', ground = 'black' } = Astro.props;
---

<div class:list={['band', `on-${ground}`]}>
  <ul role="list" class="band-row reveal">
    {photos.map((p, i) => (
      <li class:list={[i % 2 ? 'tilt-r' : 'tilt-l']}>
        <Image src={p} alt={alt} widths={[360, 600]} sizes="(min-width: 60rem) 24vw, 45vw" class="photo" />
      </li>
    ))}
  </ul>
</div>

<style>
  .band { padding: clamp(3rem, 2rem + 3vw, 5rem) var(--margin); overflow: hidden; }
  .band-row { display: grid; grid-template-columns: repeat(2, 1fr); gap: clamp(0.75rem, 0.5rem + 1.5vw, 2rem); }
  .band-row li { border: 6px solid var(--white); }
  .band-row :global(img) { aspect-ratio: 4 / 5; }
  .band-row li:nth-child(n + 3) { display: none; }
  @media (min-width: 48rem) {
    .band-row { grid-template-columns: repeat(var(--n, 3), 1fr); }
    .band-row li:nth-child(n + 3) { display: block; }
  }
</style>
