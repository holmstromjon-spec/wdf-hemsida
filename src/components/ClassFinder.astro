---
// "Hitta din klass": choose an age group and see the week's classes from
// src/data/schema.yaml. Works without JavaScript (radio buttons + CSS).
import { schema } from '../lib/data';

const grupper = schema.veckoschema.grupper;
---

<section class="finder on-light section" aria-labelledby="finder-title">
  <div class="container">
    <div class="finder-head center">
      <h2 id="finder-title">Hitta din klass</h2>
      <p class="muted">Välj ålder eller dansstil så ser du veckans pass.</p>
    </div>

    <form class="tabs" aria-label="Välj grupp">
      {grupper.map((g, i) => (
        <label>
          <input type="radio" name="grupp" value={i} checked={i === 0} />
          <span>{g.namn}</span>
        </label>
      ))}
    </form>

    <div class="panels">
      {grupper.map((g, i) => (
        <div class="panel card" data-grupp={i}>
          <h3 class="visually-hidden">{g.namn}</h3>
          <table>
            <thead>
              <tr><th scope="col">Dag</th><th scope="col">Tid</th><th scope="col">Klass</th></tr>
            </thead>
            <tbody>
              {g.dagar.flatMap((d) =>
                d.pass.map((p, j) => (
                  <tr class:list={{ 'new-day': j === 0 }}>
                    <td class="day">{j === 0 ? d.dag : ''}</td>
                    <td class="tabular time">{p.tid}</td>
                    <td>{p.klass}</td>
                  </tr>
                )),
              )}
            </tbody>
          </table>
        </div>
      ))}
    </div>

    <p class="button-row actions">
      <a class="button" href="/anmalan/">Boka kurs <span class="arrow" aria-hidden="true"></span></a>
      <a class="text-link" href="/schema/">Hela schemat och tävlingsschemat <span class="arrow" aria-hidden="true"></span></a>
    </p>
  </div>
</section>

<style>
  .finder-head { display: grid; gap: 0.5rem; margin-bottom: 2rem; }
  .tabs { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem; margin-bottom: 1.5rem; }
  .tabs label { cursor: pointer; }
  .tabs input { position: absolute; opacity: 0; pointer-events: none; }
  .tabs span {
    display: inline-flex; align-items: center; min-height: 2.5rem; padding: 0.4rem 0.95rem;
    border: 1px solid var(--line); border-radius: 999px; background: var(--white);
    font-size: 0.9375rem; font-weight: 500; transition: background-color 150ms, color 150ms, border-color 150ms;
  }
  .tabs label:hover span { border-color: var(--dark); }
  .tabs input:checked + span { background: var(--red); border-color: var(--red); color: var(--white); }
  .tabs input:focus-visible + span { outline: 2px solid var(--red); outline-offset: 2px; }

  /* Show only the chosen group. Without :has() support every group is listed. */
  @supports selector(:has(*)) {
    .panel { display: none; }
    .finder:has(input[value='0']:checked) [data-grupp='0'],
    .finder:has(input[value='1']:checked) [data-grupp='1'],
    .finder:has(input[value='2']:checked) [data-grupp='2'],
    .finder:has(input[value='3']:checked) [data-grupp='3'],
    .finder:has(input[value='4']:checked) [data-grupp='4'],
    .finder:has(input[value='5']:checked) [data-grupp='5'],
    .finder:has(input[value='6']:checked) [data-grupp='6'],
    .finder:has(input[value='7']:checked) [data-grupp='7'],
    .finder:has(input[value='8']:checked) [data-grupp='8'],
    .finder:has(input[value='9']:checked) [data-grupp='9'] { display: block; }
  }
  .panel { max-width: 46rem; margin-inline: auto; padding: 0.5rem 1.25rem; }
  .panel + .panel { margin-top: 1rem; }
  table { width: 100%; border-collapse: collapse; font-size: 0.9375rem; }
  th { text-align: left; font-weight: 500; color: var(--muted); font-size: var(--fs-small); padding: 0.6rem 0.5rem; }
  td { padding: 0.55rem 0.5rem; vertical-align: top; }
  tr.new-day td { border-top: 1px solid var(--line); }
  .day { font-weight: 500; width: 7.5rem; }
  .time { white-space: nowrap; width: 7rem; }
  @media (max-width: 40rem) {
    .panel { padding-inline: 0.5rem; }
    table { font-size: 0.875rem; }
    .day { width: 5.25rem; }
    .time { width: 5.5rem; }
    td, th { padding-inline: 0.35rem; }
  }
  .actions { justify-content: center; margin-top: 2rem; }
</style>
