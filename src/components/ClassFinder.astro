---
// "Hitta din klass": choose an age group and the week's real classes from
// src/data/schema.yaml appear as poster lines. Works without JavaScript
// (radio buttons + CSS); the full schedule is always one link away.
import { schema } from '../lib/data';

const grupper = schema.veckoschema.grupper;
---

<section class="finder on-black section" aria-labelledby="finder-title">
  <div class="wrap">
    <div class="finder-top reveal">
      <h2 id="finder-title" class="display head">Hitta din klass</h2>
      <p class="lead muted">Välj ålder eller stil – så ser du veckans pass.</p>
    </div>

    <form class="finder-tabs" aria-label="Välj grupp">
      {grupper.map((g, i) => (
        <label>
          <input type="radio" name="grupp" value={i} checked={i === 0} />
          <span>{g.namn}</span>
        </label>
      ))}
    </form>

    <div class="finder-panels">
      {grupper.map((g, i) => (
        <div class="finder-panel" data-grupp={i}>
          <h3 class="visually-hidden">{g.namn}</h3>
          <ul role="list" class="poster-lines">
            {g.dagar.flatMap((d) =>
              d.pass.map((p) => (
                <li>
                  <span class="pl-name display">{p.klass}</span>
                  <span class="pl-fact tabular">{d.dag} {p.tid}</span>
                </li>
              )),
            )}
          </ul>
        </div>
      ))}
    </div>

    <div class="finder-actions">
      <a class="button" href="/anmalan/"><span>Boka kurs</span> <span class="arrow" aria-hidden="true"></span></a>
      <a class="text-link" href="/schema/">Hela schemat och tävlingsschemat <span class="arrow" aria-hidden="true"></span></a>
    </div>
  </div>
</section>

<style>
  .finder-top { display: grid; gap: 1rem; margin-bottom: 2.5rem; }
  .finder-tabs { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 2.5rem; }
  .finder-tabs label { cursor: pointer; }
  .finder-tabs input { position: absolute; opacity: 0; pointer-events: none; }
  .finder-tabs span {
    display: inline-flex; align-items: center; min-height: 2.75rem; padding: 0.5rem 1rem;
    box-shadow: inset 0 0 0 2px var(--white); font-weight: 500;
    transition: background-color 150ms, color 150ms;
  }
  .finder-tabs label:hover span { background: #2a2a2a; }
  .finder-tabs input:checked + span { background: var(--red); box-shadow: inset 0 0 0 2px var(--red); }
  .finder-tabs input:focus-visible + span { outline: 3px solid var(--white); outline-offset: 3px; }

  /* Show only the chosen group. Without :has() support every group is listed. */
  @supports selector(:has(*)) {
    .finder-panel { display: none; }
    .finder:has(input[value='0']:checked) [data-grupp='0'],
    .finder:has(input[value='1']:checked) [data-grupp='1'],
    .finder:has(input[value='2']:checked) [data-grupp='2'],
    .finder:has(input[value='3']:checked) [data-grupp='3'],
    .finder:has(input[value='4']:checked) [data-grupp='4'],
    .finder:has(input[value='5']:checked) [data-grupp='5'],
    .finder:has(input[value='6']:checked) [data-grupp='6'],
    .finder:has(input[value='7']:checked) [data-grupp='7'],
    .finder:has(input[value='8']:checked) [data-grupp='8'],
    .finder:has(input[value='9']:checked) [data-grupp='9'] { display: block; }
  }

  .poster-lines li {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.25rem;
    padding-block: 0.6rem;
  }
  .pl-name { font-size: clamp(1.375rem, 0.9rem + 2.4vw, 3rem); line-height: 0.95; transition: color 150ms; }
  .pl-fact { font-size: var(--step-body); color: var(--muted); }
  .poster-lines li:hover .pl-name { color: var(--red); filter: brightness(1.3); }
  @media (min-width: 48rem) {
    .poster-lines li { grid-template-columns: 1fr auto; align-items: baseline; gap: 2rem; }
    .pl-fact { text-align: right; white-space: nowrap; }
  }
  .finder-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem 2.5rem; margin-top: 3rem; }
</style>
