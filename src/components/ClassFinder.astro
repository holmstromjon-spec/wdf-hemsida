---
// "Hitta din klass": choose an age group and the week's classes from src/data/schema.yaml
// appear as poster lines – big class names left, day and time right.
// Works without JavaScript (radio buttons + CSS); the full schedule is one link away.
import { schema } from '../lib/data';

const grupper = schema.veckoschema.grupper;
---

<section class="finder on-dark section" aria-labelledby="finder-title">
  <div class="container">
    <div class="finder-head">
      <h2 id="finder-title">Hitta din klass</h2>
      <p class="muted">Välj ålder eller dansstil så ser du veckans pass.</p>
    </div>

    <form class="tabs" aria-label="Välj grupp">
      {grupper.map((g, i) => (
        <label>
          <input type="radio" name="grupp" value={i} checked={i === 0} />
          <span>{g.namn}</span>
        </label>
      ))}
    </form>

    <div class="panels">
      {grupper.map((g, i) => (
        <div class="panel" data-grupp={i}>
          <h3 class="visually-hidden">{g.namn}</h3>
          <ul role="list" class="lines">
            {g.dagar.flatMap((d) =>
              d.pass.map((p) => (
                <li>
                  <span class="name">{p.klass}</span>
                  <span class="when tabular">{d.dag} <strong>{p.tid}</strong></span>
                </li>
              )),
            )}
          </ul>
        </div>
      ))}
    </div>

    <p class="button-row actions">
      <a class="button" href="/anmalan/">Boka kurs <span class="arrow" aria-hidden="true"></span></a>
      <a class="text-link" href="/schema/">Hela schemat och tävlingsschemat <span class="arrow" aria-hidden="true"></span></a>
    </p>
  </div>
</section>

<style>
  .finder { background: #141313; }
  .finder-head { display: grid; gap: 0.5rem; margin-bottom: 2rem; }
  .tabs { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 2rem; }
  .tabs label { cursor: pointer; }
  .tabs input { position: absolute; opacity: 0; pointer-events: none; }
  .tabs span {
    display: inline-flex; align-items: center; min-height: 2.5rem; padding: 0.4rem 0.95rem;
    border: 1px solid rgb(255 255 255 / 0.35); border-radius: 999px;
    font-size: 0.9375rem; font-weight: 500; transition: background-color 150ms, border-color 150ms;
  }
  .tabs label:hover span { border-color: var(--white); }
  .tabs input:checked + span { background: var(--red); border-color: var(--red); }
  .tabs input:focus-visible + span { outline: 2px solid var(--white); outline-offset: 2px; }

  /* Show only the chosen group. Without :has() support every group is listed. */
  @supports selector(:has(*)) {
    .panel { display: none; }
    .finder:has(input[value='0']:checked) [data-grupp='0'],
    .finder:has(input[value='1']:checked) [data-grupp='1'],
    .finder:has(input[value='2']:checked) [data-grupp='2'],
    .finder:has(input[value='3']:checked) [data-grupp='3'],
    .finder:has(input[value='4']:checked) [data-grupp='4'],
    .finder:has(input[value='5']:checked) [data-grupp='5'],
    .finder:has(input[value='6']:checked) [data-grupp='6'],
    .finder:has(input[value='7']:checked) [data-grupp='7'],
    .finder:has(input[value='8']:checked) [data-grupp='8'],
    .finder:has(input[value='9']:checked) [data-grupp='9'] { display: block; }
  }

  /* Poster lines */
  .lines li {
    display: grid; gap: 0.15rem; padding-block: 0.8rem;
    border-top: 1px solid rgb(255 255 255 / 0.12);
  }
  .lines li:last-child { border-bottom: 1px solid rgb(255 255 255 / 0.12); }
  .name {
    font-size: clamp(1.25rem, 0.9rem + 1.6vw, 2.25rem); font-weight: 600; line-height: 1.1;
    text-transform: uppercase; letter-spacing: -0.01em; transition: color 150ms;
  }
  .lines li:hover .name { color: #ff6f61; }
  .when { color: var(--muted); font-size: 0.9375rem; }
  .when strong { color: var(--white); font-weight: 500; margin-left: 0.35rem; }
  @media (min-width: 48rem) {
    .lines li { grid-template-columns: 1fr auto; align-items: baseline; gap: 2rem; }
    .when { text-align: right; white-space: nowrap; }
  }
  .actions { margin-top: 2.5rem; }
</style>
