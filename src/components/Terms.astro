---
// A list of headed text blocks (terms, conditions, info), heading left and text right.
interface Props {
  items: { rubrik: string; text: string }[];
}
const { items } = Astro.props;
const paragraphs = (t: string) => t.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
---

<dl class="terms">
  {items.map((i) => (
    <div class="term reveal">
      <dt class="display">{i.rubrik}</dt>
      <dd>{paragraphs(i.text).map((p) => <p>{p}</p>)}</dd>
    </div>
  ))}
</dl>

<style>
  .terms { display: grid; }
  .term { display: grid; gap: 0.75rem; padding-block: 1.75rem; }
  .term + .term { box-shadow: inset 0 2px 0 currentColor; }
  dt { font-size: clamp(1.125rem, 1rem + 0.6vw, 1.5rem); line-height: 1.1; }
  dd { margin: 0; max-width: 62ch; }
  dd p + p { margin-top: 0.75em; }
  @media (min-width: 48rem) {
    .term { grid-template-columns: minmax(12rem, 4fr) 8fr; gap: var(--gap); }
  }
</style>
