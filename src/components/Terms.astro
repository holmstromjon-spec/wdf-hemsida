---
// Headed text blocks (terms, conditions, info), as on the old site.
interface Props {
  items: { rubrik: string; text: string }[];
}
const { items } = Astro.props;
const paragraphs = (t: string) => t.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
---

<div class="terms">
  {items.map((i) => (
    <section class="term">
      <h3 class="h4">{i.rubrik}</h3>
      {paragraphs(i.text).map((p) => <p>{p}</p>)}
    </section>
  ))}
</div>

<style>
  .terms { display: grid; gap: 1.75rem; }
  .term { display: grid; gap: 0.5rem; max-width: 68ch; }
  .term p { font-size: 0.9375rem; }
</style>
