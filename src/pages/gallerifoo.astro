---
// The gallery keeps its old URL /gallerifoo/ (named after the WordPress plugin) so links and rankings survive.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import type { ImageMetadata } from 'astro';
import head from '../assets/images/galleri/dsc04438.jpg';

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/images/galleri/*.jpg', { eager: true });
const photos = Object.keys(files)
  .sort()
  .map((k) => ({ src: files[k]!.default, alt: 'Dansare från Wilson Dance Factory på scen' }));
---

<BaseLayout
  title="Galleri"
  description="Bilder från Wilson Dance Factory – uppvisningar, tävlingar och vardag i danssalarna i Helsingborg."
>
  <PageHead title="Galleri" image={head} />
  <section class="section" aria-label="Bilder">
    <div class="container">
      <PhotoGrid photos={photos} id="galleri" />
    </div>
  </section>
</BaseLayout>
