---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import ScheduleGroups from '../components/ScheduleGroups.astro';
import { schema, termin } from '../lib/data';
import head from '../assets/images/galleri/dsc03371.jpg';
---

<BaseLayout
  title="Schema"
  description="Veckoschema och tävlingsschema för Wilson Dance Factory i Helsingborg – barndans, dans för 6–13 år, 14+ och vuxna, pardans, breakdance och tävlingsklasser."
>
  <PageHead title="Schema" image={head} />

  <section class="section">
    <div class="container term-grid">
      <div class="stack">
        <h2 class="h3">{termin.rubrik}</h2>
        {termin.notis && <p class="muted">{termin.notis}</p>}
        {termin.punkter.map((p) => <p>{p}</p>)}
        <dl class="dates">
          {termin.datum.map((d) => <div><dt class="small muted">{d.etikett}</dt><dd class="h4">{d.varde}</dd></div>)}
        </dl>
      </div>
      <div class="book on-dark stack">
        <h2 class="h3">Anmälan till våra kurser görs här »</h2>
        <p>{termin.anmalan_text}</p>
        <p><a class="button" href="/anmalan/">Gå till anmälan <span class="arrow" aria-hidden="true"></span></a></p>
      </div>
    </div>
  </section>

  <section class="section on-light" aria-labelledby="vecka">
    <div class="container">
      <h2 id="vecka">Schema</h2>
      <p class="intro muted">{schema.veckoschema.intro}</p>
      <ScheduleGroups grupper={schema.veckoschema.grupper} />
    </div>
  </section>

  <section id="tavlingsschema" class="section" aria-labelledby="tavling">
    <div class="container">
      <h2 id="tavling">Tävlingsschema</h2>
      <p class="intro muted">{schema.tavlingsschema.intro}</p>
      <ScheduleGroups grupper={schema.tavlingsschema.grupper} />
    </div>
  </section>
</BaseLayout>

<style>
  .term-grid { display: grid; gap: 2.5rem; align-items: start; }
  .dates { display: flex; flex-wrap: wrap; gap: 1rem 2.5rem; margin-top: 1.5rem !important; }
  .dates dd { margin: 0; }
  .book { padding: 2rem; border-radius: var(--radius); }
  @media (min-width: 64rem) { .term-grid { grid-template-columns: 1.3fr 1fr; gap: 4rem; } }
  .intro { margin: 0.5rem 0 2rem; }
</style>
