---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import { site } from '../lib/data';
import head from '../assets/images/headers/header-2.jpg';
import h1 from '../assets/images/headers/header-1.jpg';
import h3 from '../assets/images/headers/header-3.jpg';
import h4 from '../assets/images/headers/header-4.jpg';
import visionPhoto from '../assets/images/galleri/dsc03595.jpg';

const strip = [
  { src: h1, alt: 'Dansare hos Wilson Dance Factory' },
  { src: head, alt: 'Uppvisning hos Wilson Dance Factory' },
  { src: h3, alt: 'Danslektion hos Wilson Dance Factory' },
  { src: h4, alt: 'Dansare i rörelse' },
];
---

<BaseLayout
  title="Dansa med oss"
  description="Dansa med oss på Wilson Dance Factory i Helsingborg – över 20 dansstilar, 21 medarbetare och dans för alla åldrar och nivåer."
>
  <PageHead title="Dansa med oss på Wilson Dance Factory!" image={head} />

  <section class="section">
    <div class="container">
      <ul role="list" class="cards">
        <li class="card reveal">
          <h2 class="h3">Våra dansstilar</h2>
          <p>På Wilson Dance Factory erbjuder vi över 20 st olika dansstilar i olika nivåer för alla åldersgrupper. Med andra ord så finns det dans för alla.</p>
          <a class="button" href="/dansstilar/">Se alla våra dansstilar <span class="arrow" aria-hidden="true"></span></a>
        </li>
        <li class="card reveal">
          <h2 class="h3">Våra instruktörer</h2>
          <p>Med hela 21 medarbetare så kan vi erbjuda en kvalitativ helhetsupplevelse inom dans. Oavsett tävling eller fritidsdans.</p>
          <a class="button" href="/instruktorer/">Träffa våra instruktörer <span class="arrow" aria-hidden="true"></span></a>
        </li>
        <li class="card on-red reveal">
          <h2 class="h3">Jobba hos oss?</h2>
          <p>Vi är alltid på jakt efter vår nästa medarbetare. Brinner du för dans eller känner du någon som vill jobba med dans, hör då av er till oss!</p>
          <a class="button" href="/jobba-hos-oss/">Bli en del av WDF <span class="arrow" aria-hidden="true"></span></a>
        </li>
      </ul>
    </div>
  </section>

  <section class="section on-light">
    <div class="container split">
      <div class="stack reveal">
        <h2>Alla får dansa på Wilson Dance Factory</h2>
        <p>Vår vision är att kunna erbjuda alla typer av dans till alla typer av människor. Dans är ett sätt att uttrycka sina känslor fysiskt, därför tror vi att det alltid finns någon typ av dans för alla. Hos oss är vi alltid öppna för utveckling och vi försöker alltid följa med aktuella trender inom dans för att kunna nå ut till nästa generation.</p>
        <p class="h4">Välkommen in att dansa med oss!</p>
      </div>
      <Image src={visionPhoto} alt="Dansare på scen hos Wilson Dance Factory" widths={[480, 800, 1200]} sizes="(min-width: 64rem) 34rem, 100vw" class="photo rounded split-photo" />
    </div>
  </section>

  <section class="section">
    <div class="container center stack">
      <h2>Se hur vi har det hos oss</h2>
      <p class="intro">Vi är stolta över den energin vi har skapat med Wilson Dance Factory. Detta är något vi gärna visar upp, så om ni vill se hur vi har det hos oss så kan ni gå till vårt bildbibliotek.</p>
      <ul role="list" class="strip">
        {strip.map((s) => <li><Image src={s.src} alt={s.alt} widths={[400, 700]} sizes="(min-width: 64rem) 17rem, 45vw" class="photo rounded" /></li>)}
      </ul>
      <p class="button-row"><a class="button" href="/aktuellt/#bilder">Se alla bilder <span class="arrow" aria-hidden="true"></span></a></p>
    </div>
  </section>

  <section class="section on-red">
    <div class="container center stack">
      <h2>Vill du se mer av oss?</h2>
      <p>Följ oss på Facebook och Instagram för att hänga med i vår vardag!</p>
      <p class="button-row">
        <a class="button" href={site.sociala.facebook} rel="noopener">Facebook <span class="arrow" aria-hidden="true"></span></a>
        <a class="button" href={site.sociala.instagram} rel="noopener">Instagram <span class="arrow" aria-hidden="true"></span></a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .cards { display: grid; gap: 1.25rem; }
  .cards .on-red { border-color: var(--red); }
  .cards li { padding: 2rem clamp(1.25rem, 1rem + 1.5vw, 2rem); display: grid; gap: 1rem; align-content: start; justify-items: start; }
  @media (min-width: 64rem) { .cards { grid-template-columns: repeat(3, 1fr); } .cards li { grid-template-rows: auto 1fr auto; } }

  .split { display: grid; gap: 2.5rem; align-items: center; }
  .split-photo { aspect-ratio: 4 / 3; }
  @media (min-width: 64rem) { .split { grid-template-columns: 1fr 1fr; gap: 4rem; } }

  .intro { max-width: 46rem; margin-inline: auto; }
  .strip { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin-block: 2rem !important; }
  .strip :global(img) { aspect-ratio: 4 / 3; }
  @media (min-width: 64rem) { .strip { grid-template-columns: repeat(4, 1fr); } }
</style>
