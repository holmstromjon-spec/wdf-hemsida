---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import head from '../assets/images/galleri/dsc03680.jpg';

const stilar = (await getCollection('dansstilar', (d) => d.data.visa_pa_dansstilar)).sort(
  (a, b) => a.data.ordning - b.data.ordning,
);
const rendered = await Promise.all(stilar.map(async (s) => ({ ...s, Content: (await render(s)).Content })));
---

<BaseLayout
  title="Våra dansstilar"
  description="Över 20 dansstilar på Wilson Dance Factory i Helsingborg: barndans, dansmix, balett, TikTok, Boys Only, show, breakdance, disco, hiphop, jazz & modernt och mer."
>
  <PageHead title="Våra dansstilar" image={head} />

  <section class="section">
    <div class="container">
      <div class="intro stack">
        <h2>Vi erbjuder ett stort sortiment av dans</h2>
        <p>Vi på Wilson Dance Factory har en stor passion för dans och ett väldigt brett spektrum när det kommer till olika dansstilar. Du kommer garanterat att hitta en stil som passar dig om du väljer att dansa med oss.</p>
      </div>

      <ul role="list" class="styles">
        {rendered.map((s) => (
          <li id={s.id} class="style card reveal">
            {(s.data.foto ?? s.data.bild) && <Image src={(s.data.foto ?? s.data.bild)!} alt="" widths={[360, 600, 900]} sizes="(min-width: 64rem) 22rem, (min-width: 40rem) 45vw, 90vw" class="photo" />}
            <div class="style-text">
              <h3 class="h4">{s.data.namn}</h3>
              <div class="stack"><s.Content /></div>
              <p><a class="button" href="/anmalan/">Boka kurs <span class="arrow" aria-hidden="true"></span></a></p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .intro { max-width: 46rem; margin-bottom: 2.5rem; }
  .styles { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr)); }
  .style { display: grid; grid-template-rows: auto 1fr; overflow: hidden; scroll-margin-top: 7rem; }
  .style :global(img) { aspect-ratio: 4 / 3; }
  .style-text { display: grid; gap: 0.75rem; align-content: start; padding: 1.25rem 1.25rem 1.5rem; font-size: 0.9375rem; }
  .style-text p:last-child { margin-top: 0.5rem; }
</style>
