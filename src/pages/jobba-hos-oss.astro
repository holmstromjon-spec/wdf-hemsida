---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import { site } from '../lib/data';
import head from '../assets/images/headers/header-4.jpg';
import photo from '../assets/images/galleri/dsc04118.jpg';

// No form (decision 3): a mail button with a ready subject line and the points to include.
const subject = encodeURIComponent('Jobbansökan – Wilson Dance Factory');
const body = encodeURIComponent('Hej!\n\nJag vill söka jobb som (assistent / receptionist / danslärare):\n\nErfarenhet:\nÅlder:\nMotivering:\n\nNamn:\nTelefon:\n');
const mailto = `mailto:${site.epost}?subject=${subject}&body=${body}`;
---

<BaseLayout
  title="Jobba hos oss?"
  description="Wilson Dance Factory växer och söker kontinuerligt nya medarbetare – assistenter, receptionister och danslärare. Skicka din ansökan till oss."
>
  <PageHead title="Jobba hos oss" image={head} />

  <section class="section">
    <div class="container split">
      <div class="stack">
        <p class="lead"><strong>Wilson Dance Factory växer – och vi söker kontinuerligt nya medarbetare!</strong></p>
        <p>Vi välkomnar ansökningar till tjänster som assistent, receptionist och danslärare.</p>
        <p>När du skickar in din ansökan vill vi att du inkluderar:</p>
        <ul class="list">
          <li><strong>Erfarenhet</strong> – tidigare arbete, dansbakgrund eller annan relevant kompetens.</li>
          <li><strong>Ålder</strong> – för att vi ska kunna matcha dig med rätt uppdrag.</li>
          <li><strong>Motivering</strong> – berätta varför du vill arbeta hos oss och vad just du kan bidra med.</li>
        </ul>
        <p>Skicka in din ansökan till oss och bli en del av ett kreativt, energifyllt och välkomnande team!</p>
      </div>
      <Image src={photo} alt="Dansare från Wilson Dance Factory" widths={[480, 800]} sizes="(min-width: 64rem) 30rem, 100vw" class="photo rounded split-photo" />
    </div>
  </section>

  <section id="jobba" class="section on-dark">
    <div class="container center stack">
      <h2>Skicka in din jobbansökan</h2>
      <p>Du mailar in din jobbansökan till oss på <a href={`mailto:${site.epost}`}>{site.epost}</a>. Knappen öppnar ett färdigt mejl med det vi vill veta.</p>
      <p class="button-row"><a class="button" href={mailto}>Bli en del av WDF <span class="arrow" aria-hidden="true"></span></a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .split { display: grid; gap: 2.5rem; align-items: center; }
  .split-photo { aspect-ratio: 4 / 5; max-height: 34rem; }
  .list { padding-left: 1.2em; display: grid; gap: 0.4rem; }
  @media (min-width: 64rem) { .split { grid-template-columns: 1.3fr 1fr; gap: 4rem; } }
  #jobba a:not(.button) { color: inherit; }
</style>
