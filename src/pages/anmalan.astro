---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Terms from '../components/Terms.astro';
import { bokningsvillkor, site } from '../lib/data';
import PhotoBand from '../components/PhotoBand.astro';
import head from '../assets/images/galleri/dsc03422.jpg';
import b1 from '../assets/images/galleri/dsc04085.jpg';
import b2 from '../assets/images/galleri/dsc04216.jpg';
import b3 from '../assets/images/galleri/dsc04434.jpg';
---

<BaseLayout
  title="Anmälan"
  description="Anmäl dig till kurser, läger och tävlingsklasser på Wilson Dance Factory i Helsingborg. Anmälan sker via dans.se."
>
  <PageHead
    lines={['Anmälan']}
    image={head}
    imageAlt="Dansare från Wilson Dance Factory på scen"
    lead="Anmälan för våra kurser är öppna fram tills dess att det tredje kurstillfället för terminen har passerat. Om du vill anmäla dig till en kurs efter detta så får du istället kontakta oss via telefon eller mail."
  >
    <a class="text-link" href="#bokningsvillkor">Bokningsvillkor <span class="arrow" aria-hidden="true"></span></a>
  </PageHead>

  <!-- dans.se (CogWork) embed: the link is replaced by the course list when the script loads,
       and stays a working link to the same list without it. We never change its content. -->
  <section class="booking on-white section" aria-labelledby="kurser">
    <div class="wrap">
      <h2 id="kurser" class="display head">Våra kurser</h2>
      <div class="cw-embed">
        <a class="cwLoadContent button" href={site.dans_se.shop}><span>Visa kurser och boka på dans.se</span> <span class="arrow" aria-hidden="true"></span></a>
        <script is:inline type="text/javascript" src={site.dans_se.script}></script>
      </div>
    </div>
  </section>

  <PhotoBand photos={[b1, b2, b3]} />

  <section id="bokningsvillkor" class="on-paper section" aria-labelledby="villkor-title">
    <div class="wrap">
      <h2 id="villkor-title" class="display head" style="--w:15">Bokningsvillkor</h2>
      <Terms items={bokningsvillkor} />
      <p class="contact"><a class="button" href="/kontakt/"><span>Kontakta oss här</span> <span class="arrow" aria-hidden="true"></span></a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .cw-embed { margin-top: 2rem; min-height: 4rem; }
  #bokningsvillkor { scroll-margin-top: 0; }
  #bokningsvillkor .head { margin-bottom: 1.5rem; }
  .contact { margin-top: 2.5rem; }
</style>
