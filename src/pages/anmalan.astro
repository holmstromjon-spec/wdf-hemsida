---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Terms from '../components/Terms.astro';
import { bokningsvillkor, site } from '../lib/data';
import head from '../assets/images/galleri/dsc03422.jpg';
---

<BaseLayout
  title="Anmälan"
  description="Anmäl dig till kurser, läger och tävlingsklasser på Wilson Dance Factory i Helsingborg. Anmälan sker via dans.se."
>
  <PageHead title="Anmälan" image={head} />

  <!-- dans.se (CogWork) embed: the link is replaced by the course list when the script loads,
       and stays a working link to the same list without it. We never change its content. -->
  <section class="section">
    <div class="container">
      <h2>Anmälan</h2>
      <p class="intro">Anmälan för våra kurser är öppna fram tills dess att det tredje kurstillfället för terminen har passerat. Om du vill anmäla dig till en kurs efter detta så får du istället kontakta oss via telefon eller mail.</p>
      <p><a class="button button--ghost" href="#bokningsvillkor">Bokningsvillkor <span class="arrow" aria-hidden="true"></span></a></p>
      <div class="cw-embed">
        <a class="cwLoadContent button" href={site.dans_se.shop}>Visa kurser och boka på dans.se <span class="arrow" aria-hidden="true"></span></a>
        <script is:inline type="text/javascript" src={site.dans_se.script}></script>
      </div>
    </div>
  </section>

  <section id="bokningsvillkor" class="section on-light" aria-labelledby="villkor-title">
    <div class="container">
      <h2 id="villkor-title">Bokningsvillkor</h2>
      <div class="terms-wrap"><Terms items={bokningsvillkor} /></div>
      <p><a class="button" href="/kontakt/">Kontakta oss här <span class="arrow" aria-hidden="true"></span></a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .intro { max-width: 52rem; margin: 0.75rem 0 1.5rem; }
  .cw-embed { margin-top: 2.5rem; min-height: 4rem; }
  .terms-wrap { margin: 2rem 0; }
</style>
