---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Reviews from '../components/Reviews.astro';
import Icon from '../components/Icon.astro';
import { site } from '../lib/data';
import head from '../assets/images/miljo/miljo-1.jpg';
---

<BaseLayout
  title="Kontakt"
  description="Kontakta Wilson Dance Factory: info@wilsondancefactory.se, 042-13 14 08, Kapplöpningsgatan 6 i Helsingborg."
>
  <PageHead title="Kontakta oss" image={head} />

  <section class="section">
    <div class="container grid">
      <div class="stack">
        <h2>Kontaktuppgifter</h2>
        <ul role="list" class="contact">
          <li><Icon name="mail" size={20} /><a href={`mailto:${site.epost}`}>{site.epost}</a></li>
          <li><Icon name="phone" size={20} /><span><a href={site.telefon_href}>{site.telefon}</a><br /><span class="small muted">({site.telefon_not})</span></span></li>
          <li><Icon name="pin" size={20} /><a href={site.google.vagbeskrivning} rel="noopener">{site.adress.gata}, {site.adress.postnummer} {site.adress.ort}</a></li>
        </ul>

        <h3 class="h4">Följ oss på sociala medier</h3>
        <p class="button-row">
          <a class="button" href={site.sociala.facebook} rel="noopener"><Icon name="facebook" size={16} /> Facebook</a>
          <a class="button" href={site.sociala.instagram} rel="noopener"><Icon name="instagram" size={16} /> Instagram</a>
        </p>

        <h3 class="h4">Vill du hitta till våra lokaler?</h3>
        <p><a class="button" href={site.google.vagbeskrivning} rel="noopener">Få vägbeskrivning <span class="arrow" aria-hidden="true"></span></a></p>

        <h3 class="h4">Våra öppettider</h3>
        <dl class="hours">
          {site.oppettider.map((o) => <div><dt>{o.dag}</dt><dd class="tabular">{o.tid}</dd></div>)}
        </dl>
      </div>
      <!-- The Google map loads only when the visitor asks for it, so nothing is sent to
           Google before that (see the privacy policy). No JavaScript: the link still works. -->
      <div class="map rounded on-dark" data-map={site.google.karta_embed}>
        <div class="map-placeholder">
          <Icon name="pin" size={36} />
          <p class="h4">{site.adress.gata}<br />{site.adress.postnummer} {site.adress.ort}</p>
          <p class="button-row">
            <button class="button" type="button" data-map-load>Visa karta <span class="arrow" aria-hidden="true"></span></button>
            <a class="text-link" href={site.google.vagbeskrivning} rel="noopener">Öppna i Google Maps <span class="arrow" aria-hidden="true"></span></a>
          </p>
          <p class="small muted">Kartan hämtas från Google när du klickar.</p>
        </div>
      </div>
    </div>
  </section>

  <Reviews />
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-map]').forEach((box) => {
    box.querySelector('[data-map-load]')?.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      frame.title = 'Karta: Kapplöpningsgatan 6, Helsingborg';
      frame.src = box.dataset.map!;
      frame.referrerPolicy = 'no-referrer-when-downgrade';
      box.replaceChildren(frame);
      frame.focus();
    });
  });
</script>

<style>
  .grid { display: grid; gap: 3rem; }
  .contact { display: grid; gap: 0.9rem; }
  .contact li { display: flex; gap: 0.75rem; align-items: flex-start; }
  .contact :global(.icon) { color: var(--red); margin-top: 0.2rem; }
  .contact a { text-decoration: none; }
  .contact a:hover { color: var(--red); }
  .stack h3 { margin-top: 2rem; }
  .hours div { display: flex; justify-content: space-between; max-width: 20rem; gap: 1rem; }
  .hours dt { color: var(--muted); }
  .map { min-height: 26rem; display: grid; }
  .map-placeholder { display: grid; place-content: center; justify-items: center; gap: 1rem; padding: 2rem; text-align: center; }
  .map-placeholder :global(.icon) { color: #ff8a80; }
  .map-placeholder .button-row { justify-content: center; }
  .map :global(iframe) { width: 100%; height: 100%; min-height: 26rem; border: 0; display: block; }
  @media (min-width: 64rem) { .grid { grid-template-columns: 1fr 1.3fr; gap: 4rem; } }
</style>
