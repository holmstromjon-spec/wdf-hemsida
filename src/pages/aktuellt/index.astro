---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import type { ImageMetadata } from 'astro';

const nyheter = (await getCollection('aktuellt')).sort((a, b) => b.data.datum.valueOf() - a.data.datum.valueOf());
const datum = (d: Date) => d.toLocaleDateString('sv-SE', { day: 'numeric', month: 'long', year: 'numeric' });

const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/images/miljo/*.jpg', { eager: true });
const miljo = Object.keys(files)
  .sort((a, b) => Number(a.match(/(\d+)\.jpg$/)?.[1]) - Number(b.match(/(\d+)\.jpg$/)?.[1]))
  .map((k) => ({ src: files[k]!.default, alt: 'Miljöbild från Wilson Dance Factory' }));
---

<BaseLayout
  title="Aktuellt"
  description="Nyheter, event, läger och erbjudanden från Wilson Dance Factory i Helsingborg."
>
  <PageHead
    lines={['Aktuellt']}
    lead="Hos oss på Wilson Dance Factory händer det roliga saker hela tiden! Med jämna mellanrum anordnar vi olika sorters event – allt ifrån dansläger och högtidsfirande till tävlingar och olika erbjudanden."
  />

  <section class="on-white section" aria-labelledby="nyheter">
    <div class="wrap">
      <h2 id="nyheter" class="display head">Nyheter</h2>
      {nyheter.length === 0 ? (
        <p class="lead empty">Inga nyheter just nu. Följ oss på Facebook och Instagram så missar du inget!</p>
      ) : (
        <ul role="list" class="news">
          {nyheter.map((n) => (
            <li class="news-item reveal">
              <a href={`/aktuellt/${n.id}/`}>
                {n.data.bild && <Image src={n.data.bild} alt={n.data.bild_alt ?? ''} widths={[400, 700]} sizes="(min-width: 60rem) 30vw, 90vw" class="photo" />}
                <time datetime={n.data.datum.toISOString()} class="small muted">{datum(n.data.datum)}</time>
                <h3 class="display news-title">{n.data.titel}</h3>
                {n.data.utdrag && <p>{n.data.utdrag}</p>}
                <span class="text-link">Läs mer <span class="arrow" aria-hidden="true"></span></span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <section id="bilder" class="on-paper section" aria-labelledby="bilder-title">
    <div class="wrap">
      <h2 id="bilder-title" class="display head">Bildgalleri</h2>
      <p class="more"><a class="text-link" href="/gallerifoo/">Fler bilder i galleriet <span class="arrow" aria-hidden="true"></span></a></p>
      <PhotoGrid photos={miljo} id="miljo" />
    </div>
  </section>
</BaseLayout>

<style>
  .empty { margin-top: 1.5rem; max-width: 40ch; }
  .news { display: grid; gap: 2.5rem var(--gap); grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); margin-top: 2rem; }
  .news-item a { display: grid; gap: 0.6rem; text-decoration: none; }
  .news-item :global(img) { aspect-ratio: 3 / 2; margin-bottom: 0.5rem; }
  .news-title { font-size: clamp(1.25rem, 1rem + 1vw, 1.75rem); line-height: 1.05; }
  .news-item a:hover .news-title { color: var(--red); }
  #bilder { scroll-margin-top: 0; }
  .more { margin: 1rem 0 2rem; }
</style>
