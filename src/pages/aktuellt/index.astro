---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import type { ImageMetadata } from 'astro';
import head from '../../assets/images/miljo/miljo-10.jpg';

const nyheter = (await getCollection('aktuellt')).sort((a, b) => b.data.datum.valueOf() - a.data.datum.valueOf());
const datum = (d: Date) => d.toLocaleDateString('sv-SE', { day: 'numeric', month: 'long', year: 'numeric' });

const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/images/miljo/*.jpg', { eager: true });
const miljo = Object.keys(files)
  .sort((a, b) => Number(a.match(/(\d+)\.jpg$/)?.[1]) - Number(b.match(/(\d+)\.jpg$/)?.[1]))
  .map((k) => ({ src: files[k]!.default, alt: 'Miljöbild från Wilson Dance Factory' }));
---

<BaseLayout
  title="Aktuellt"
  description="Nyheter, event, läger och erbjudanden från Wilson Dance Factory i Helsingborg."
>
  <PageHead title="Aktuellt" image={head} />

  <section class="section" aria-labelledby="nyheter">
    <div class="container">
      <h2 id="nyheter">Nyheter</h2>
      {nyheter.length === 0 ? (
        <p class="empty muted">Inga nyheter just nu. Följ oss på Facebook och Instagram så missar du inget!</p>
      ) : (
        <ul role="list" class="news">
          {nyheter.map((n) => (
            <li class="card news-item reveal">
              <a href={`/aktuellt/${n.id}/`}>
                {n.data.bild && <Image src={n.data.bild} alt={n.data.bild_alt ?? ''} widths={[400, 700]} sizes="(min-width: 64rem) 22rem, 90vw" class="photo" />}
                <div class="news-body">
                  <time datetime={n.data.datum.toISOString()} class="small muted">{datum(n.data.datum)}</time>
                  <h3 class="h4">{n.data.titel}</h3>
                  {n.data.utdrag && <p>{n.data.utdrag}</p>}
                  <span class="text-link">Läs mer »</span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <section id="bilder" class="section on-light" aria-labelledby="bilder-title">
    <div class="container">
      <h2 id="bilder-title">Bildgalleri</h2>
      <p class="more"><a class="text-link" href="/gallerifoo/">Fler bilder i galleriet <span class="arrow" aria-hidden="true"></span></a></p>
      <PhotoGrid photos={miljo} id="miljo" />
    </div>
  </section>
</BaseLayout>

<style>
  .empty { margin-top: 1rem; }
  .news { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); margin-top: 1.5rem; }
  .news-item { overflow: hidden; }
  .news-item a { display: block; text-decoration: none; }
  .news-item :global(img) { aspect-ratio: 3 / 2; }
  .news-body { display: grid; gap: 0.5rem; padding: 1.25rem; }
  .more { margin: 0.5rem 0 1.5rem; }
</style>
