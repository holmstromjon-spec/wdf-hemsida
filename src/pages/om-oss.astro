---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Reviews from '../components/Reviews.astro';
import { site } from '../lib/data';
import head from '../assets/images/miljo/miljo-11.jpg';
import paul from '../assets/images/instruktorer/paul-wilson.jpg';
import room from '../assets/images/miljo/miljo-9.jpg';
---

<BaseLayout
  title="Om oss"
  description="Wilson Dance Factory är ditt säkra val när fötterna inte längre kan vara stilla. Danskurser från 2 år, 21 utbildade instruktörer och assistenter på Kapplöpningsgatan i Helsingborg."
>
  <PageHead title="Om oss på Wilson Dance Factory" image={head} />

  <section class="section">
    <div class="container split">
      <div class="stack">
        <p class="lead">Wilson Dance Factory är ditt säkra val när fötterna inte längre kan vara stilla. Vi erbjuder danskurser från 2 års ålder och helt upp till när fötterna inte längre orkar dansa.</p>
        <h2>Dans för alla!</h2>
        <p>I vårt breda kursutbud finns det flertal dansstilar att välja mellan, och vare sig du är nybörjare, övad eller avancerad dansare är vi säkra på att vi hittar fram till DIN nya dansframtid hos oss.</p>
        <h3 class="h4">Hos oss</h3>
        <p>Teamet på Wilson Dance Factory består av 21 utbildade instruktörer och assistenter.</p>
        <p>Dansskolan som ni finner på Kapplöpningsgatan 6 är på över 900 kvm med 3 stora danssalar samt 2 mindre danssalar ämnade för egen träning.</p>
        <h3 class="h4">Vår målsättning</h3>
        <p>Vi strävar alltid efter att ge dansare trygghet, främja självkänsla och hitta glädje genom dans och musik.</p>
      </div>
      <Image src={room} alt="Danssal hos Wilson Dance Factory" widths={[480, 800, 1200]} sizes="(min-width: 64rem) 32rem, 100vw" class="photo rounded split-photo" />
    </div>
  </section>

  <section class="section on-dark" aria-labelledby="values-title">
    <div class="container values">
      <Image src={paul} alt="Paul Wilson, VD för Wilson Dance Factory" widths={[300, 500]} sizes="14rem" class="photo paul" />
      <div class="stack">
        <h2 id="values-title">Vår värdegrund</h2>
        <blockquote class="lead quote">”{site.citat.text}”</blockquote>
        <p>– {site.citat.namn}<br /><span class="muted">{site.citat.titel}</span></p>
      </div>
    </div>
  </section>

  <Reviews />
</BaseLayout>

<style>
  .split { display: grid; gap: 2.5rem; align-items: start; }
  .split-photo { aspect-ratio: 4 / 5; }
  @media (min-width: 64rem) { .split { grid-template-columns: 1.3fr 1fr; gap: 4rem; } }
  .values { display: grid; gap: 2rem; align-items: center; justify-items: start; }
  .paul { width: 12rem; aspect-ratio: 1; border-radius: 50%; }
  .quote { font-style: italic; font-weight: 300; max-width: 46rem; }
  @media (min-width: 48rem) { .values { grid-template-columns: auto 1fr; gap: 3rem; } }
</style>
