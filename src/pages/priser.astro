---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Terms from '../components/Terms.astro';
import { priser, site } from '../lib/data';
import head from '../assets/images/headers/header-3.jpg';
import hoodie from '../assets/images/butik/vuxen-hoodie.jpg';
import { Image } from 'astro:assets';
import PhotoBand from '../components/PhotoBand.astro';
import b1 from '../assets/images/galleri/dsc02513.jpg';
import b2 from '../assets/images/galleri/dsc03327.jpg';
import b3 from '../assets/images/galleri/dsc03361.jpg';
---

<BaseLayout
  title="Priser"
  description="Priser för kurser, terminskort, klippkort och presentkort hos Wilson Dance Factory i Helsingborg."
>
  <PageHead lines={['Prislista']} lead={priser.kurser.intro} image={head} imageAlt="Dansare hos Wilson Dance Factory" />

  <section class="on-paper section" aria-labelledby="kurser-title">
    <div class="wrap">
      <h2 id="kurser-title" class="display head" style="--w:15">Kurser och terminsavgifter</h2>
      <ul role="list" class="prices">
        {priser.kurser.rader.map((r) => (
          <li class="price reveal">
            <span class="display price-name">{r.namn}</span>
            <span class="display price-value tabular">{r.pris}</span>
            <span class="price-info muted">{r.info}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <PhotoBand photos={[b1, b2, b3]} />

  <section class="on-red section" aria-labelledby="pk-title">
    <div class="wrap">
      <h2 id="pk-title" class="display head">Presentkort</h2>
      <p class="lead pk-intro">{priser.presentkort.intro}</p>
      <ul role="list" class="cards">
        {priser.presentkort.rader.map((r) => (
          <li class="card on-white reveal">
            <span class="display card-value">{r.pris}</span>
            <span class="display card-name">{r.namn}</span>
            <span class="small">{r.info}</span>
          </li>
        ))}
      </ul>
      <p class="pk-more">Har du övriga frågor så kan du höra av dig till oss. <a class="text-link" href="/kontakt/">Kontakta oss <span class="arrow" aria-hidden="true"></span></a></p>
    </div>
  </section>

  <section class="on-black shop-band">
    <div class="wrap shop-grid">
      <Image src={hoodie} alt="Svart hoodie med namntryck från Wilsons webbshop" widths={[200, 400]} sizes="10rem" class="shop-img" />
      <h2 class="display shop-h">Priserna för våra produkter finns i butiken</h2>
      <a class="button" href="/shop/"><span>Gå till webbshoppen</span> <span class="arrow" aria-hidden="true"></span></a>
    </div>
  </section>

  <section class="on-white section" aria-labelledby="info-title">
    <div class="wrap">
      <h2 id="info-title" class="display head">Information</h2>
      <Terms items={priser.information} />
      <p class="mail">Frågor? Mejla <a href={`mailto:${site.epost}`}>{site.epost}</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .prices { margin-top: 2.5rem; }
  .price {
    display: grid; gap: 0.25rem 1.5rem; align-items: baseline;
    padding-block: 1.25rem; box-shadow: inset 0 -2px 0 var(--black);
  }
  @media (min-width: 48rem) { .price { grid-template-columns: 1fr auto; } }
  .price-name { font-size: clamp(1.125rem, 0.8rem + 1.6vw, 2.25rem); line-height: 1.05; }
  .price-value { font-size: clamp(1.125rem, 0.8rem + 1.6vw, 2.25rem); color: var(--red); white-space: nowrap; }
  .price-info { grid-column: 1 / -1; font-size: var(--step-small); }
  .pk-intro { margin: 1rem 0 2.5rem; max-width: 44ch; }
  .cards { display: grid; gap: 3rem 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr)); }
  .card { display: grid; gap: 0.5rem; padding: 1.5rem; aspect-ratio: 1.6; align-content: space-between; }
  .card-name { font-size: 1.125rem; }
  .card-value { font-size: clamp(1.75rem, 1.2rem + 2vw, 2.75rem); color: var(--red); line-height: 1; }
  .pk-more { margin-top: 2.5rem; }
  .shop-band { padding-block: 3rem; }
  .shop-grid { display: grid; gap: 1.5rem; align-items: center; }
  .shop-h { font-size: clamp(1.25rem, 1rem + 1.2vw, 2rem); line-height: 1.05; }
  .shop-img { width: 10rem; background: var(--white); rotate: -4deg; }
  @media (min-width: 60rem) { .shop-grid { grid-template-columns: auto 1fr auto; gap: 3rem; } }
  .mail { margin-top: 2rem; }
  #info-title { margin-bottom: 1.5rem; }
</style>
