---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Terms from '../components/Terms.astro';
import Icon from '../components/Icon.astro';
import { priser } from '../lib/data';
import head from '../assets/images/headers/header-3.jpg';
import shopPhoto from '../assets/images/galleri/dsc03626.jpg';
---

<BaseLayout
  title="Priser"
  description="Priser för kurser, terminskort, klippkort och presentkort hos Wilson Dance Factory i Helsingborg."
>
  <PageHead title="Prislista" image={head} />

  <section class="section">
    <div class="container layout">
      <div class="price-panel on-dark">
        <h2 class="h3">Kurser och terminsavgifter</h2>
        <p class="small muted">{priser.kurser.intro}</p>
        <ul role="list" class="prices">
          {priser.kurser.rader.map((r) => (
            <li>
              <span class="row"><span class="name">{r.namn}</span><span class="dots" aria-hidden="true"></span><strong class="price tabular">{r.pris}</strong></span>
              <span class="note small muted">{r.info}</span>
            </li>
          ))}
        </ul>

        <h2 class="h3 pk">Presentkort</h2>
        <p class="small muted">{priser.presentkort.intro}</p>
        <ul role="list" class="prices">
          {priser.presentkort.rader.map((r) => (
            <li>
              <span class="row"><span class="name">{r.namn}</span><span class="dots" aria-hidden="true"></span><strong class="price tabular">{r.pris}</strong></span>
              <span class="note small muted">{r.info}</span>
            </li>
          ))}
        </ul>
        <p class="small">Har du övriga frågor så kan du höra av dig till oss</p>
        <p><a class="button" href="/kontakt/">Kontakta oss <span class="arrow" aria-hidden="true"></span></a></p>
      </div>

      <div class="side">
        <div class="stack">
          <h2 class="h3">Priserna för våra produkter finns i butiken</h2>
          <p><a class="button" href="/shop/">Gå till webbshoppen <Icon name="cart" size={16} /></a></p>
          <Image src={shopPhoto} alt="Dansare från Wilson Dance Factory på scen" widths={[480, 800]} sizes="(min-width: 64rem) 30rem, 100vw" class="photo rounded side-photo" />
        </div>
        <div class="info">
          <h2 class="h3">Information</h2>
          <Terms items={priser.information} />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .layout { display: grid; gap: 3rem; align-items: start; }
  @media (min-width: 64rem) { .layout { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 3rem; } }

  .price-panel { padding: clamp(1.5rem, 1rem + 2vw, 2.5rem); border-radius: var(--radius); display: grid; gap: 0.75rem; }
  .prices { display: grid; gap: 1rem; margin: 1rem 0 0.5rem; }
  .prices li { display: grid; gap: 0.15rem; }
  .row { display: flex; align-items: baseline; gap: 0.6rem; }
  .name { font-size: 1.0625rem; font-weight: 300; }
  .dots { flex: 1; min-width: 1.5rem; border-bottom: 1px solid rgb(255 255 255 / 0.4); translate: 0 -0.3em; }
  .price { white-space: nowrap; font-weight: 500; }
  .pk { margin-top: 1.5rem; }

  .side { display: grid; gap: 3rem; }
  .side-photo { aspect-ratio: 16 / 10; margin-top: 1.5rem !important; }
  .info .h3 { margin-bottom: 1.25rem; }
</style>
