---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../lib/data';
import swish from '../assets/images/brand/swish.png';
---

<BaseLayout title="Tack för din beställning" description="Tack för din beställning hos Wilson Dance Factory." noindex>
  <section class="thanks on-red">
    <div class="wrap">
      <h1 class="display thanks-title">
        <span class="mask-line"><span>Tack för din</span></span>
        <span class="mask-line"><span>beställning!</span></span>
      </h1>
      <div class="after-mask stack thanks-text">
        <p class="lead">Vi kommer att behandla din beställning när vi ser att betalning har kommit in.</p>
        <p data-order hidden>Ditt ordernummer: <strong class="tabular" data-order-nr></strong><span data-sum hidden> · Att betala: <strong class="tabular" data-sum-nr></strong></span></p>
        <p>En orderbekräftelse har skickats till din e-post.</p>
      </div>
    </div>
  </section>

  <section class="pay on-black section">
    <div class="wrap pay-grid reveal">
      <div class="stack">
        <p>Det går att betala via Swish eller i receptionen i vår dansstudio. Ange alltid ditt ordernummer som meddelande när du betalar med Swish.</p>
        <h2 class="pay-h">Vårt Swish nummer:</h2>
        <p class="display swish-nr">{site.swish}</p>
      </div>
      <Image src={swish} alt="Swish" width={360} class="swish-logo" />
    </div>
  </section>
</BaseLayout>

<script>
  const q = new URLSearchParams(location.search);
  const order = q.get('order');
  if (order && /^[A-Z0-9-]{6,30}$/.test(order)) {
    document.querySelector('[data-order-nr]')!.textContent = order;
    document.querySelector<HTMLElement>('[data-order]')!.hidden = false;
    const sum = Number(q.get('summa'));
    if (sum > 0) {
      document.querySelector('[data-sum-nr]')!.textContent = `${sum.toLocaleString('sv-SE')} kr`;
      document.querySelector<HTMLElement>('[data-sum]')!.hidden = false;
    }
  }
</script>

<style>
  .thanks { padding-block: clamp(3rem, 2rem + 5vw, 7rem); }
  .thanks-title { font-size: calc((100vw - 2 * var(--margin)) / 13.5); line-height: 0.9; }
  .thanks-text { margin-top: 2rem; max-width: 40rem; }
  .thanks-text strong { font-weight: 500; }
  .pay-grid { display: grid; gap: 3rem; align-items: center; }
  .pay-h { font-size: var(--step-lead); font-weight: 500; margin-top: 1.5rem; }
  .swish-nr { font-size: clamp(2rem, 1rem + 5vw, 5rem); line-height: 1; }
  .swish-logo { width: min(100%, 22rem); }
  @media (min-width: 60rem) { .pay-grid { grid-template-columns: 2fr 1fr; } }
</style>
