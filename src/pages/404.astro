---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import { nav } from '../lib/nav';
---

<BaseLayout title="Sidan hittades inte" description="Sidan du letar efter finns inte." noindex>
  <PageHead title="Den sidan kan inte hittas" />
  <section class="section">
    <div class="container stack">
      <p class="lead">Sidan du letar efter finns inte längre. Prova någon av de här:</p>
      <p class="button-row">
        <a class="button" href="/">Startsidan <span class="arrow" aria-hidden="true"></span></a>
        {nav.slice(1, 6).map((n) => <a class="button button--ghost" href={n.href}>{n.label}</a>)}
      </p>
    </div>
  </section>
</BaseLayout>
